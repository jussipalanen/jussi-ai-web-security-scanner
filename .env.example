# Copy to .env and adjust. All values are optional; defaults are conservative.
JUSSIAI_REQUEST_TIMEOUT_SECONDS=10.0
JUSSIAI_TOTAL_SCAN_TIMEOUT_SECONDS=60.0
JUSSIAI_MAX_REDIRECTS=5
JUSSIAI_MAX_RESPONSE_BYTES=1048576
JUSSIAI_MAX_CONCURRENT_REQUESTS=4
JUSSIAI_ALLOWED_PORTS=[80,443]
JUSSIAI_OLLAMA_BASE_URL=http://127.0.0.1:11434
JUSSIAI_OLLAMA_MODEL=llama3.1
JUSSIAI_OLLAMA_TIMEOUT_SECONDS=60.0
JUSSIAI_AI_ENABLED=true
