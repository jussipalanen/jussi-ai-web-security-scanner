          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"rejected with 422\", () => pm.response.to.have.status(422));",
              "const body = pm.response.json();",
              "// Two error shapes reach the client: our own handler returns a plain string,",
              "// while Pydantic's request-model errors return an array of error objects.",
              "const detail = typeof body.detail === \"string\"",
              "    ? body.detail",
              "    : JSON.stringify(body.detail);",
              "pm.test(\"explains why it was rejected\", () => {",
              "    pm.expect(body).to.have.property(\"detail\");",
              "    pm.expect(detail).to.not.be.empty;",
              "});",
              "pm.test(\"leaks no internal detail\", () => {",
              "    pm.expect(body).to.not.have.property(\"traceback\");",
              "    pm.expect(detail).to.not.match(/Traceback|File \"\\/|site-packages/);",
              "});"
            ]
          }
        }
