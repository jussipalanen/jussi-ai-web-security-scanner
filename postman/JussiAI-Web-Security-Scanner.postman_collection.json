    {
      "name": "Scan",
      "description": "Runs the deterministic checks and returns findings, each with a description and a concrete remediation step.\n\nThese requests make real outbound GETs to whatever `targetUrl` points at. Only scan hosts you own or are authorised to test.\n\nCurrently implemented: HTTP status, response time, HTTPS, HTTP->HTTPS upgrade, redirect chain, security headers, information disclosure. No score and no AI commentary yet.",
      "item": [
        {
          "name": "Scan target",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{targetUrl}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/scan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "scan"
              ]
            },
            "description": "The main request. Point `targetUrl` at a host you are allowed to scan."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"scan completed with 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"reports where it ended up\", () => {",
                  "    pm.expect(body.final_url).to.match(/^https?:\\/\\//);",
                  "    pm.expect(body.status_code).to.be.a(\"number\");",
                  "});",
                  "pm.test(\"returns findings\", () => {",
                  "    pm.expect(body.findings).to.be.an(\"array\").and.to.not.be.empty;",
                  "});",
                  "pm.test(\"every finding has id, title, severity and description\", () => {",
                  "    body.findings.forEach((f) => {",
                  "        pm.expect(f.check_id, \"check_id\").to.be.a(\"string\").and.to.not.be.empty;",
                  "        pm.expect(f.title, \"title\").to.be.a(\"string\").and.to.not.be.empty;",
                  "        pm.expect(f.description, \"description\").to.be.a(\"string\");",
                  "        pm.expect([\"info\", \"low\", \"medium\", \"high\"]).to.include(f.severity);",
                  "    });",
                  "});",
                  "pm.test(\"every finding says how to fix it\", () => {",
                  "    body.findings.forEach((f) => {",
                  "        pm.expect(f.remediation, f.check_id).to.be.a(\"string\").and.to.not.be.empty;",
                  "    });",
                  "});",
                  "pm.test(\"severity counts add up to the finding total\", () => {",
                  "    const c = body.counts;",
                  "    pm.expect(c.high + c.medium + c.low + c.info).to.eql(body.findings.length);",
                  "});",
                  "pm.test(\"no score is claimed yet\", () => {",
                  "    pm.expect(body).to.not.have.property(\"score\");",
                  "});",
                  "// Surface the actionable items in the Postman console.",
                  "body.findings",
                  "    .filter((f) => f.severity !== \"info\" && f.remediation !== \"No action needed.\")",
                  "    .forEach((f) => console.log(`[${f.severity}] ${f.title}\\n  FIX: ${f.remediation}`));"
                ]
              }
            }
          ]
        },
