{
  "info": {
    "_postman_id": "9f2c1b40-5a7e-4c3d-8f16-2b7d4e9a0c31",
    "name": "JussiAI Web Security Scanner",
    "description": "API collection for the JussiAI Web Security Scanner backend.\n\nSet `baseUrl` and `targetUrl` in the environment before running. `targetUrl` deliberately defaults to the reserved documentation domain `example.com` - point it at a host you own and are authorised to test.\n\n`POST /scan` makes real outbound requests to the target. `POST /validate` makes none: it only decides whether a target is allowed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Service health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
